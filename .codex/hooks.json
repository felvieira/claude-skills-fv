{
  "description": "Dev Team Kit hooks para Codex. `command` roda no shell POSIX do usuario (sh/bash/zsh). `commandWindows` roda no shell configurado do Codex no Windows (PowerShell ou cmd) — por isso usa so `node <caminho relativo>`, sem $(...), for /f, & ou | que so um dos dois shells entende. Abrir a sessao do Codex na raiz do repo.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/hooks/scripts/runtime-dispatcher.mjs\" SessionStart",
            "commandWindows": "node hooks/scripts/runtime-dispatcher.mjs SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/hooks/scripts/runtime-dispatcher.mjs\" UserPromptSubmit",
            "commandWindows": "node hooks/scripts/runtime-dispatcher.mjs UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/hooks/scripts/runtime-dispatcher.mjs\" PreToolUse",
            "commandWindows": "node hooks/scripts/runtime-dispatcher.mjs PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/hooks/scripts/runtime-dispatcher.mjs\" PostToolUse",
            "commandWindows": "node hooks/scripts/runtime-dispatcher.mjs PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/hooks/scripts/runtime-dispatcher.mjs\" Stop",
            "commandWindows": "node hooks/scripts/runtime-dispatcher.mjs Stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}