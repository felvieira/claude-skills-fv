# .env.example — Stack Default
# Copie para .env e preencha os valores. NUNCA commite .env.
# Vars com :? são obrigatórias e causam erro imediato se ausentes.

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DOMAIN=localhost

# ─────────────────────────────────────────────
# Database (Postgres)
# ─────────────────────────────────────────────
DB_USER=app
DB_PASSWORD=changeme_strong_password
DB_NAME=app
# Construída automaticamente pelo docker-compose — não edite abaixo se usar compose
DATABASE_URL=postgresql://app:changeme_strong_password@localhost:5432/app

# ─────────────────────────────────────────────
# Cache + Queue (Redis)
# ─────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password
REDIS_URL=redis://:changeme_redis_password@localhost:6379

# ─────────────────────────────────────────────
# Object Storage (MinIO / S3-compatible)
# ─────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_secret
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=uploads
# Para prod com S3 real: troque STORAGE_ENDPOINT por https://s3.amazonaws.com
# e use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# ─────────────────────────────────────────────
# Auth (Better Auth)
# ─────────────────────────────────────────────
BETTER_AUTH_SECRET=changeme_32_char_random_string_here
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (adicione conforme necessário)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────
# LLM (OpenRouter — gateway unificado)
# ─────────────────────────────────────────────
# Docs: https://openrouter.ai/docs
# Sem vendor lock: troque o model sem mudar código
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Models por tier (ver openrouter/config.ts)
LLM_MODEL_FAST=meta-llama/llama-3.1-8b-instruct:free
LLM_MODEL_BALANCED=anthropic/claude-sonnet-4-5
LLM_MODEL_DEEP=anthropic/claude-opus-4-5

# ─────────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────────
# Dev: usa Mailpit (porta 1025 no docker-compose.override.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
# Prod: Resend, Postmark, SES — open source via SMTP standard

# ─────────────────────────────────────────────
# TLS / Let's Encrypt (produção)
# ─────────────────────────────────────────────
ACME_EMAIL=you@example.com
