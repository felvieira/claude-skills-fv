{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "semgrep-triager I/O",
  "description": "Validates input/output envelope for the semgrep-triager subagent",
  "type": "object",
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "required": ["sarif_path", "codebase_root"],
      "properties": {
        "sarif_path": {
          "type": "string",
          "description": "Path to SARIF file from semgrep-scanner"
        },
        "batch_limit": {
          "type": "integer",
          "default": 50,
          "description": "Max findings to process"
        },
        "codebase_root": {
          "type": "string",
          "description": "Repo root for source context reads"
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["confidence"],
      "properties": {
        "true_positives": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Confirmed vulnerabilities with fix suggestion"
        },
        "false_positives": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Confirmed FPs with suppression justification"
        },
        "needs_investigation": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Ambiguous findings requiring human review"
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      }
    }
  }
}
